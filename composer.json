{
    "name": "hryvinskyi/magento2-catalog-sorting-metrics",
    "description": "Catalog sorting capability: per-store product metrics that sort methods define in SQL, refreshed on a schedule and written into the product search documents; only products whose value changed are reindexed.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "hryvinskyi/magento2-catalog-sorting": "^1.0",
        "magento/framework": "*",
        "magento/module-store": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-search": "*",
        "magento/module-config": "*",
        "magento/module-backend": "*",
        "magento/module-cron": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\CatalogSortingMetrics\\": ""
        }
    }
}
